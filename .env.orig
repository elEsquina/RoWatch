# Generate production values with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET=replace-with-another-long-random-value

# Application and database
DATABASE_URL=sqlite:////app/instance/rowatch.db
PORT=5000
FLASK_DEBUG=0

# Docker and Gunicorn
ROWATCH_PORT=5000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
ROWATCH_DISABLE_PURGE=0

# Admin account (created or synchronized when the server starts)
ROWATCH_ADMIN_USERNAME=admin
ROWATCH_ADMIN_EMAIL=admin@rowatch.local
ROWATCH_ADMIN_PASSWORD=replace-with-at-least-12-characters

ROWATCH_SESSION_DAYS=7
